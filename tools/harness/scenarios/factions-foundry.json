{
  "name": "factions-foundry",
  "description": "Plays the foundry against the syndicate: shows the build menus of its constructor and factories, trains its tier-1 units, refuses the other faction's unit, and stages a mixed battle in the middle of the map.",
  "map": "plain_and_simple",
  "seed": 1,
  "minutes": 1.5,
  "speed": 1,
  "fog": false,
  "players": [
    {
      "type": "human",
      "faction": "foundry"
    },
    {
      "type": "ai",
      "personality": "balanced",
      "faction": "syndicate"
    }
  ],
  "setup": [
    {
      "do": "give",
      "player": "own",
      "resources": {
        "timber": 300,
        "iron": 300,
        "copper": 300,
        "oil": 300
      }
    },
    {
      "do": "spawn",
      "player": "own",
      "unit": "vehicle_factory",
      "spot": "base",
      "offset": [
        -9,
        6
      ],
      "expect_ok": true
    },
    {
      "do": "spawn",
      "player": "own",
      "unit": "aircraft_factory",
      "spot": "base",
      "offset": [
        9,
        7
      ],
      "expect_ok": true
    }
  ],
